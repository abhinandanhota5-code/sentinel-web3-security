{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel backend API: serves grounded AI explanations and PRISM evaluation signals",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck-tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/**/*.test.ts\"",
    "start": "node --env-file=../.env dist/main.js",
    "check": "npm run build && npm run typecheck && npm run typecheck-tests && npm run test"
  },
  "dependencies": {
    "@sentinel/ai": "file:../sentinel-ai",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
