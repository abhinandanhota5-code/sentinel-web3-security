[TEMPLATE]
# Required for indexed Ethereum history. Never commit real credentials.
ETHERSCAN_API_KEY=

# Required for direct on-chain reads such as allowances, balances, owners, and proxy slots.
ETHEREUM_RPC_URL=

# Required for the Sentinel AI explanation layer (sentinel-ai providers).
# Server-side only: never expose to the frontend, never log, never commit a real key.
# EXPLANATION_PROVIDER selects the vendor: "ollama" (local, default for the demo), "gemini" or "openrouter".
# With EXPLANATION_PROVIDER=ollama -> OLLAMA_MODEL/OLLAMA_BASE_URL (no API key needed).
# With EXPLANATION_PROVIDER=gemini -> GEMINI_API_KEY; with "openrouter" -> OPENROUTER_API_KEY.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
EXPLANATION_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional sentinel-api settings (defaults shown) ---
# PORT=8787
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
# EXPLANATION_TIMEOUT_MS=120000
# EXPLANATION_MAX_RETRIES=3
# MAX_EVIDENCE_RECORDS=200
# BODY_LIMIT=1mb
